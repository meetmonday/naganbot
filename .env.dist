COMPOSE_PROJECT_NAME=naganbot # const.
BUILD=false # build application containers. available values: true, false

### > app ###
ENV=dev # project environment. available values: dev, prod
TELEGRAM_BOT_TOKEN= # Bot authorization token which can be obtained using @BotFather
DATABASE_DSN=postgres://postgres@db/app?sslmode=disable # database connection string (postgres:// or mysql://). docs: https://gorm.io/docs/connecting_to_the_database.html
FORCE_USERNAME=meetmonday # Telegram username allowed to use /force command
COOLDOWN_MINUTES=1440 # cooldown between games in minutes (default: 1440 = 24 hours)
### < app ##

### > dev ###
DB_PORT=5432 # external database connection port
### < dev ###
